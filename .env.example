# ============================================================
# Scientific Literature RAG System — Environment Variables
# ============================================================
# Rename this file to .env and fill in your API keys.
# NEVER commit the .env file to version control.

# ── OpenAI (required if llm_provider = "openai") ──────────
OPENAI_API_KEY=sk-...

# ── Google Gemini (required if llm_provider = "gemini") ───
GEMINI_API_KEY=AIza...

# ── HuggingFace (required for gated models like LLaMA 2) ──
HUGGINGFACE_TOKEN=hf_...
